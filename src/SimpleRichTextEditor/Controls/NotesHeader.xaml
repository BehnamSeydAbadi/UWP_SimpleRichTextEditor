<UserControl
    x:Class="SimpleRichTextEditor.Controls.NotesHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleRichTextEditor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Border Background="#2D2D30" Padding="12">
        <StackPanel>
            <TextBlock Text="My Notes"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="White"/>

            <TextBlock Text="All notes"
                       FontSize="13"
                       Foreground="#CCCCCC"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
